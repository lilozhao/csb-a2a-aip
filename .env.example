# ==============================================================================
# CSB A2A · 环境变量模板
# ==============================================================================
# 用法：
#   cp .env.example .env      # 然后按需填写
#   （.env 已被 .gitignore 排除，绝不入库）
#
# 加载方式：start-v5.sh 等启动脚本以 `set -a; . ./.env; set +a` 导入，
#           故这里写入的值对**所有启动路径**（容器自启 / keepalive / 手动）生效。
# ==============================================================================

# ── ① 身份名（最重要 · 必填） ────────────────────────────────
# [明澈原则 P2「身份不许有默认值」] 身份名必须显式给出，缺则拒绝启动。
# 本变量优先；历史变量 CDP_NAME 作为兼容回退（命中时打印 deprecation 提示）。
# 注意：本值必须与 identity 文件里的 name 一致，否则启动时拒绝（防身份漂移）。
# 🔗 跨库一致性：若同一实例还装了其他 CSB 库（csb-security 等），各库 .env 的
#    A2A_AGENT_NAME 必须是**同一个值**（身份名是实例级，不是库级）。
A2A_AGENT_NAME=your-agent-name

# ── ② 身份文件路径（可选） ─────────────────────────────────
# 不设则用同目录 identity.json。多实例部署时用它指向各自的身份文件。
# A2A_IDENTITY_PATH=/opt/data/csb-a2a-aip/identity.json

# ── ③ 监听端口（可选，默认 3100） ──────────────────────────
# A2A_PORT=3100

# ── ④ 注册表地址 ──────────────────────────────────────────
# 容器内网示例：http://172.28.0.4:3099 ；公网：http://csbc.lilozkzy.top:3099
# ⚠️ 本值是**实例特有针对**，勿写 127.0.0.1（会造成注册失败/DHT 降级）。
# A2A_REGISTRY_URL=http://172.28.0.4:3099

# ── ⑤ 对外地址（可选） ─────────────────────────────────────
# 优先级：A2A_HOST > identity.publicHost > identity.host
# A2A_HOST=172.28.0.214

# ── ⑥ 桥接 / UAC（可选） ───────────────────────────────────
# A2A_BRIDGE_UAC=on
# A2A_BRIDGE_ADAPTER=hermes

# ── ⑦ LLM 路由（可选） ─────────────────────────────────────
# A2A_LLM_API_KEY=***                  # 密钥，勿入库
# A2A_LLM_TIMEOUT_MS=30000
