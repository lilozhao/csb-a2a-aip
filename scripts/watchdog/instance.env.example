# ==============================================================================
# instance.env.example —— A2A 看门狗 · 实例配置模板
# ==============================================================================
# 用法：复制为 **同目录的 instance.env**（该文件不进仓，见 .gitignore），再改成
#       本实例的值。所有实例私有值（路径 / URL / 启动命令 / 私有 export）都放这里。
#
#   cp scripts/watchdog/instance.env.example scripts/watchdog/instance.env
#
# 变量全部可选——不设就用 a2a-watchdog.sh 里的默认值（除 A2A_DIR / A2A_START_CMD 必填）。
# ==============================================================================

# ── 部署根目录（必填） ──
A2A_DIR="/opt/data/csb-a2a-aip"

# ── 启动命令（必填）：在 A2A_DIR 下执行；输出以 **追加** 方式写 server.log ──
A2A_START_CMD="node server_v5.js"

# ── 探活 ──
A2A_HEALTH_URL="http://localhost:3100/health"
A2A_HEALTH_RETRIES=6          # 探测次数（>1 才叫重试；默认 6）
A2A_HEALTH_INTERVAL=2         # 首次间隔秒
A2A_HEALTH_INTERVAL_MAX=5     # 间隔上限秒
A2A_HEALTH_TIMEOUT=5          # 单次 curl 超时秒

# ── 路径（默认按 A2A_DIR 推导，需要时显式覆盖） ──
# A2A_PID_FILE="${A2A_DIR}/server.pid"
# A2A_LOG_DIR="${A2A_DIR}/logs"
# A2A_SERVER_LOG="${A2A_LOG_DIR}/server.log"
# A2A_WATCHDOG_LOG="${A2A_LOG_DIR}/watchdog.log"

# ── PID 纠正用的进程匹配模式 ──
# ⚠️ 别写太宽：模式越宽越可能命中无关进程 → PID 写错 → 下轮误重启。
#    本实例部署路径相关的唯一串最稳。
A2A_PROC_PATTERN="node server_v5.js"

# ── server.log 轮转（字节；0 或留空 = 不轮转） ──
A2A_SERVER_LOG_MAX_BYTES=20971520    # 20MB

# ── 钩子（可选） ──
# A2A_ALWAYS_HOOK=""      # 每次调用都跑（如懒安装目录自愈）
# A2A_PRE_START_HOOK=""   # 仅重启前跑

# ==============================================================================
# 实例私有：启动所需的环境变量 —— 由本机持有，**绝不进仓**
# （a2a-watchdog.sh 启动前会 source 本文件，因此这里的 export 会传给被启动的服务）
# ==============================================================================
# export A2A_SECURITY_HANDSHAKE_AID="/opt/data/csb-security/data/<实例>-aid.json"
# export A2A_SECURITY_HANDSHAKE_KEY="/opt/data/csb-security/data/<实例>-private-key.pem"
# export A2A_SECURITY_HANDSHAKE_USER_PUBKEY='{"crv":"Ed25519",...}'
# export A2A_IDENTITY_PATH="${A2A_DIR}/identity.json"
# export A2A_BRIDGE_HERMES=on
# export A2A_BRIDGE_ADAPTER=hermes
# export A2A_BRIDGE_UAC=on
# export A2A_HERMES_CONFIRM_READ=db
# export A2A_HERMES_DB_PATH=/opt/data/state.db
# export A2A_HERMES_CHAT_ID=oc_xxx        # 内部会话标识（勿外发）
